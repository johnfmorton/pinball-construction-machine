{
  "name": "pinball-construction-machine",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Build, play, and rate pinball tables in the browser. Phase 0: physics prototype.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-replay": "tsx scripts/verify-replay.ts",
    "sim": "tsx scripts/headless-sim.ts",
    "traps": "tsx scripts/find-traps.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
