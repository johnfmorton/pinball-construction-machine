{
  "name": "pinball-construction-machine",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Build, play, and rate pinball tables in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold error && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-replay": "tsx scripts/verify-replay.ts",
    "sim": "tsx scripts/headless-sim.ts",
    "traps": "tsx scripts/find-traps.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "laravel-vite-plugin": "^3.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "svelte": "^5.57.1",
    "three": "^0.186.1"
  }
}
